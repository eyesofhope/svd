<?xml version="1.0" encoding="utf-8"?>
<!--
    Soft three-stop gradient that frames the empty downloads state. We use a
    bolder accent at the top fading into the surface colour, so the new
    design is unmistakable next to the old plain-white version.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#101A73E8"
        android:endColor="#00FFFFFF"
        android:startColor="#331A73E8"
        android:type="linear" />
</shape>
