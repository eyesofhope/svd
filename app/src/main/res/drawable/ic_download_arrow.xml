<?xml version="1.0" encoding="utf-8"?>
<!--
    Static download glyph used as the base drawable for the AnimatedVectorDrawable.
    The arrow head and shaft are kept in their own groups so we can translate
    the head independently in the AVD.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Tray / bottom line -->
    <group android:name="tray_group">
        <path
            android:name="tray"
            android:fillColor="#FF000000"
            android:pathData="M5,20 H19 V22 H5 Z" />
    </group>

    <!-- Shaft of the arrow -->
    <group android:name="shaft_group">
        <path
            android:name="shaft"
            android:fillColor="#FF000000"
            android:pathData="M11,3 H13 V14 H11 Z" />
    </group>

    <!-- Arrow head -->
    <group
        android:name="head_group"
        android:translateY="0">
        <path
            android:name="head"
            android:fillColor="#FF000000"
            android:pathData="M12,18 L6,12 H9 V11 H15 V12 H18 Z" />
    </group>
</vector>
