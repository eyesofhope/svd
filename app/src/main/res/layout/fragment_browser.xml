<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.BrowserViewModel" />

    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- Hidden helper used by previous implementation; kept to preserve binding contract -->
        <LinearLayout
            android:id="@+id/new_tab_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_new_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_tab" />
        </LinearLayout>

        <com.myAllVideoBrowser.ui.main.home.browser.CustomViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:currentItem="@{viewModel.currentTab}"
            app:items="@{viewModel.tabs}" />

        <!-- Tab switcher drawer -->
        <LinearLayout
            android:id="@+id/drawer_layout_content"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/colorSurface"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_drawer_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_normal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tabs"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/drawer_overflow"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu"
                    android:padding="6dp"
                    app:srcCompat="@drawable/more_vert_24px"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Tabs list (data set programmatically by BrowserFragment so we can
                 segregate normal vs incognito tabs in the drawer). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabs_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/padding_small"
                android:paddingTop="@dimen/padding_small" />

            <!-- Favorite sites footer -->
            <LinearLayout
                android:id="@+id/btn_favorite_sites"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_normal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/favorite_sites"
                    app:srcCompat="@drawable/bookmarks_24px"
                    app:tint="@color/brand_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/favorite_sites"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_medium" />
            </LinearLayout>

            <!-- Quick actions row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_drawer_action_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_small">

                <ImageView
                    android:id="@+id/btn_drawer_back"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desktop_mode"
                    android:padding="6dp"
                    app:srcCompat="@drawable/arrow_back24px"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_drawer_home"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home"
                    android:padding="6dp"
                    app:srcCompat="@drawable/home_48px"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_drawer_forward"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desktop_mode"
                    android:padding="6dp"
                    app:srcCompat="@drawable/arrow_forward24px"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_new_tab_drawer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/new_tab"
                    android:padding="6dp"
                    app:srcCompat="@drawable/add_new_tab_icon24"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>
