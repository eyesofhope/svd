<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.progress.ProgressViewModel" />

        <variable
            name="mainViewModel"
            type="com.myAllVideoBrowser.ui.main.home.MainViewModel" />

        <variable
            name="adapter"
            type="com.myAllVideoBrowser.ui.component.adapter.ProgressAdapter" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground">

        <!-- Top bar: "Downloading" title + total-count chip + overflow.
             The chip is hidden while there are no downloads so the empty
             state stays clean. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            app:menu="@menu/menu_progress_top"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_section_downloading"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_count"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/padding_small"
                    android:clickable="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_small"
                    android:visibility="@{viewModel.progressInfos.size() == 0 ? View.GONE : View.VISIBLE}"
                    app:chipBackgroundColor="@color/color_gray_1"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipStartPadding="10dp"
                    app:chipEndPadding="10dp"
                    tools:text="2" />

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <FrameLayout
            android:id="@+id/progress_native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_progress"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="@dimen/padding_tiny"
            android:paddingBottom="@dimen/padding_normal"
            app:items="@{viewModel.progressInfos}"
            app:layout_constraintBottom_toTopOf="@id/storage_chip"
            app:layout_constraintTop_toBottomOf="@id/progress_native_ad_container" />

        <!-- ===================================================================
             Empty state — shown when there are no active downloads. The
             gradient background, hero illustration and stat pills replace
             the previous spartan icon-and-text layout.
             =================================================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_empty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_empty_state_gradient"
            android:fillViewport="true"
            android:visibility="@{viewModel.progressInfos.size() == 0 ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toTopOf="@id/storage_chip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_native_ad_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/padding_large"
                android:paddingTop="56dp"
                android:paddingBottom="@dimen/padding_large">

                <!-- Hero illustration on a soft halo. -->
                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginBottom="@dimen/padding_normal">

                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_empty_hero_circle" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_empty_icon"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_empty_downloads" />

                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/progress_empty_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="@dimen/text_xxlarge"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/progress_empty_message"
                    android:textColor="@color/color_gray_2"
                    android:textSize="@dimen/text_small" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom storage chip: "X GB of Y GB used" -->
        <LinearLayout
            android:id="@+id/storage_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_storage_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_normal"
            android:paddingVertical="@dimen/padding_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/folder_open_24px"
                app:tint="@color/color_gray_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_storage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_small"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/color_gray_2"
                android:textSize="@dimen/text_small"
                tools:text="89.78 GB of 113 GB used" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/anchor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
