<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.video.VideoViewModel" />

        <variable
            name="mainViewModel"
            type="com.myAllVideoBrowser.ui.main.home.MainViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar always visible, regardless of empty/non-empty state -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/title_video" />

        <!-- Hidden ad slot kept for compatibility with existing native-ad wiring -->
        <FrameLayout
            android:id="@+id/finished_native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- The list of finished videos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_video"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:items="@{viewModel.localVideos}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/finished_native_ad_container" />

        <!-- ===================================================================
             Empty state — shown when no videos have been downloaded yet.
             Uses a soft brand gradient, a hero illustration on a halo,
             a tip card and a CTA that drops the user into the browser.
             =================================================================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_empty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_empty_state_gradient"
            android:fillViewport="true"
            android:visibility="@{viewModel.localVideos.size() == 0 ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/padding_large"
                android:paddingTop="48dp"
                android:paddingBottom="@dimen/padding_large">

                <!-- Hero illustration on a soft halo -->
                <FrameLayout
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginBottom="@dimen/padding_normal">

                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_empty_hero_circle" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_empty_icon"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_empty_finished" />

                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/video_empty_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="@dimen/text_xxlarge"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:text="@string/video_empty_subtitle"
                    android:textColor="@color/color_gray_2"
                    android:textSize="@dimen/text_small" />

                <!-- Primary CTA: jump to the browser tab -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_browse"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_empty_finished_cta"
                    android:backgroundTint="@null"
                    android:minWidth="200dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/padding_large"
                    android:text="@string/video_empty_cta"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_medium"
                    app:icon="@drawable/public_24px"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@android:color/white"
                    tools:ignore="UnusedAttribute" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/anchor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
