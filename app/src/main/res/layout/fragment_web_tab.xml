<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.main.home.browser.homeTab.BrowserHomeFragment">

    <data>

        <import type="android.view.View" />

        <import type="com.myAllVideoBrowser.R" />

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.webTab.WebTabViewModel" />

        <variable
            name="videoTabVModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.detectedVideos.IVideoDetector" />

        <variable
            name="browserMenuListener"
            type="com.myAllVideoBrowser.ui.main.home.browser.BrowserListener" />

        <variable
            name="settingsViewModel"
            type="com.myAllVideoBrowser.ui.main.settings.SettingsViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/customView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/containerBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    app:contentInsetEnd="0dp"
                    app:contentInsetStart="0dp">

                    <!-- Chrome-style single-row top bar:
                         Home | URL pill (with leading icon + refresh) | + | Tab counter | 3-dot menu -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingHorizontal="@dimen/padding_small">

                        <!-- Home button -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_home_button"
                            android:layout_width="@dimen/home_top_icon_size"
                            android:layout_height="@dimen/home_top_icon_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/home"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/home_48px"
                            app:tint="?attr/colorOnSurface"
                            tools:ignore="VectorDrawableCompat" />

                        <!-- URL pill -->
                        <FrameLayout
                            android:id="@+id/url_pill"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/padding_tiny"
                            android:layout_marginEnd="@dimen/padding_tiny"
                            android:background="@drawable/bg_url_pill"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/iv_new_tab"
                            app:layout_constraintStart_toEndOf="@id/iv_home_button"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/iv_url_lead"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="start|center_vertical"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/url_info"
                                app:srcCompat="@drawable/ic_url_lead_tune"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/et_search"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:focusable="@{viewModel.isTabInputFocused}"
                                android:focusableInTouchMode="@{viewModel.isTabInputFocused}"
                                android:hint="@string/browser_search_hint"
                                android:imeOptions="actionDone"
                                android:inputType="textUri"
                                android:maxLines="1"
                                android:onClick="@{() -> viewModel.changeTabFocus(true)}"
                                android:paddingStart="38dp"
                                android:paddingEnd="40dp"
                                android:singleLine="true"
                                android:text="@{viewModel.getTabTextInput()}"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="@color/hint_text"
                                android:textCursorDrawable="@null"
                                android:textSize="@dimen/text_small"
                                app:items="@{viewModel.listTabSuggestions}" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_close_refresh"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="2dp"
                                android:adjustViewBounds="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/reload"
                                android:onClick="@{() -> viewModel.isShowProgress() ? browserMenuListener.onBrowserStopClicked() : browserMenuListener.onBrowserReloadClicked()}"
                                android:padding="8dp"
                                android:scaleType="centerInside"
                                app:srcCompat="@{viewModel.progressIcon}"
                                app:tint="?attr/colorOnSurfaceVariant"
                                tools:ignore="VectorDrawableCompat" />
                        </FrameLayout>

                        <!-- New tab (+) button -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_new_tab"
                            android:layout_width="@dimen/home_top_icon_size"
                            android:layout_height="@dimen/home_top_icon_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/new_tab"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tab_counter_container"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/add_new_tab_icon24"
                            app:tint="?attr/colorOnSurface"
                            tools:ignore="VectorDrawableCompat" />

                        <!-- Tab counter -->
                        <FrameLayout
                            android:id="@+id/tab_counter_container"
                            android:layout_width="@dimen/home_top_icon_size"
                            android:layout_height="@dimen/home_top_icon_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/tabs"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/browser_menu_button"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tab_counter"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_tab_counter_square"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="1"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <!-- 3-dot menu -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/browser_menu_button"
                            android:layout_width="@dimen/home_top_icon_size"
                            android:layout_height="@dimen/home_top_icon_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/menu"
                            android:onClick="@{() -> browserMenuListener.onBrowserMenuClicked()}"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/more_vert_24px"
                            app:tint="?attr/colorOnSurface"
                            tools:ignore="VectorDrawableCompat" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.appbar.MaterialToolbar>

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:id="@+id/webview_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

                <FrameLayout
                    android:layout_width="3dp"
                    android:layout_height="700dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ProgressBar
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="700dp"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_load_data"
                        android:rotation="90" />
                </FrameLayout>


                <FrameLayout
                    android:id="@+id/fullscreen_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browser_progress_size"
                    android:background="@android:color/transparent"
                    android:progress="@{viewModel.progress}"
                    android:progressDrawable="@drawable/progress_load_data"
                    android:visibility="@{viewModel.isShowProgress ? View.VISIBLE : View.GONE}"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.myAllVideoBrowser.ui.component.widget.MovableContainer
                android:id="@+id/floating_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="@android:color/transparent"
                android:backgroundTint="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:focusedByDefault="false"
                android:foregroundGravity="center"
                android:translationZ="20dp"
                android:visibility="@{settingsViewModel.getVideoButtonState() ? View.VISIBLE : View.GONE}"
                app:layout_anchorGravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/padding_large"
                    android:backgroundTint="?attr/colorPrimary"
                    android:clickable="@{videoTabVModel.isDetectionSettled().get() ? true : false}"
                    android:contentDescription="@string/open_download_dialog_or_restart"
                    android:onClick="@{() -> videoTabVModel.showVideoInfo()}"
                    android:alpha="@{videoTabVModel.isDetectionSettled().get() ? 1.0f : 0.85f}"
                    android:src="@{videoTabVModel.isDetectionSettled().get() ? videoTabVModel.getDownloadBtnIcon().get() : R.drawable.invisible_24px}"
                    app:tint="@color/white"
                    app:borderWidth="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:ignore="ContentDescription" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/loadingWavy"
                    android:layout_width="57dp"
                    android:layout_height="57dp"
                    android:layout_margin="@dimen/padding_large"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/round_corner"
                    android:backgroundTint="@android:color/transparent"
                    android:contentDescription="@string/loading_image_view"
                    android:focusable="false"
                    android:translationZ="@dimen/padding_small"
                    android:visibility="@{(videoTabVModel.getDownloadBtnIcon().get() == R.drawable.invisible_24px || !videoTabVModel.isDetectionSettled().get()) ? View.VISIBLE : View.GONE}"
                    app:layout_constraintBottom_toBottomOf="@+id/fab"
                    app:layout_constraintEnd_toEndOf="@+id/fab"
                    app:layout_constraintStart_toStartOf="@+id/fab"
                    app:layout_constraintTop_toTopOf="@+id/fab"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/loading_dots" />
            </com.myAllVideoBrowser.ui.component.widget.MovableContainer>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>

</layout>
