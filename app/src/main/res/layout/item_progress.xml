<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="progressInfo"
            type="com.myAllVideoBrowser.data.local.room.entity.ProgressInfo" />

        <variable
            name="downloadId"
            type="Long" />

        <variable
            name="isRegular"
            type="Boolean" />

        <variable
            name="progressListener"
            type="com.myAllVideoBrowser.ui.component.adapter.ProgressListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_normal"
        android:layout_marginVertical="@dimen/padding_small"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_card_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_normal">

            <!-- Multi-select check (hidden by default) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/ic_check_circle_filled"
                android:elevation="2dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@id/iv_thumbnail"
                tools:visibility="visible" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/customImageViewRounded"
                tools:src="@drawable/ic_video_24dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding_normal"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@{progressInfo.videoInfo.name}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/text_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btn_close"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/iv_thumbnail"
                app:layout_constraintTop_toTopOf="@id/iv_thumbnail"
                tools:text="Boss_wants_to_fuck_his_beautif…" />

            <!-- Cross / cancel button (with confirmation dialog) -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/progress_remove_item"
                android:padding="6dp"
                android:src="@drawable/ic_close_thin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_thumbnail"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/padding_normal"
                android:layout_marginTop="@dimen/padding_small"
                app:indicatorColor="@color/brand_accent"
                app:layout_constraintEnd_toStartOf="@id/btn_play"
                app:layout_constraintStart_toEndOf="@id/iv_thumbnail"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="3dp"
                tools:progress="38" />

            <!-- Size / status (line 1) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_gray_2"
                android:textSize="@dimen/text_small"
                app:layout_constraintEnd_toStartOf="@id/btn_play"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/progress_bar"
                app:layout_constraintTop_toBottomOf="@id/progress_bar"
                tools:text="12.82 MB / 38.06 MB · paused" />

            <!-- Live download speed (line 2 — under the status so it never
                 overlaps the size) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/brand_accent"
                android:textSize="@dimen/text_tiny"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btn_play"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/progress_bar"
                app:layout_constraintTop_toBottomOf="@id/tv_status"
                tools:text="↓ 1.4 MB/s" />

            <!-- Play preview / globe replacement -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/progress_play"
                android:padding="6dp"
                android:src="@drawable/ic_play_filled_circle"
                app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail"
                app:layout_constraintEnd_toStartOf="@id/btn_download"
                app:layout_constraintTop_toTopOf="@id/progress_bar" />

            <!-- Animated circular download button (canvas-driven) -->
            <com.myAllVideoBrowser.ui.component.widget.AnimatedDownloadButton
                android:id="@+id/btn_download"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/progress_download_action"
                app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/progress_bar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>
