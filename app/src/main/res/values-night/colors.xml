<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-mode color overrides.

      `color_gray_1` (#F1F3F7 in light mode) is used as a light "subtle surface"
      fill behind several widgets: the Downloading count chip, the bottom storage
      pill and thumbnail placeholders. In dark mode that near-white value renders
      as a glaring bright block against the dark background. Override it with a
      dark elevated-surface tone so those surfaces sit naturally on the dark UI
      while keeping the same semantic meaning. Light mode is unaffected.
    -->
    <color name="color_gray_1">#2B2B2F</color>

    <!--
      The new-design palette below defines several near-white "soft surface" and
      divider colors. On top of them the layouts place foreground text/icons via
      ?attr/colorOnSurface, which flips to near-white in dark mode. With no night
      override the surface stays near-white too, so the content becomes invisible
      (e.g. the tab-switcher drawer rows, header and the search/prefix bars).
      Re-map them to dark equivalents so the same foregrounds stay readable. Light
      mode keeps the originals.
    -->
    <!-- Soft accent surface: drawer header, tab-switcher rows, "how to download"
         CTA, help illustration, selected progress/video cards. Blue-tinted dark
         slate so it still reads as an accented surface. -->
    <color name="brand_accent_soft">#243447</color>
    <!-- Neutral elevated surface: home search bar, quick-prefix row, drawer
         bottom action row. -->
    <color name="search_bar_bg">#2B2B2F</color>
    <!-- Hairline dividers and card strokes throughout the app, including the line
         above the bottom navigation bar. -->
    <color name="settings_divider">#33363B</color>
</resources>
